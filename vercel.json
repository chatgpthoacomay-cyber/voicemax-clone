{
  "version": 2,
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "installCommand": "npm install && pip3 install -r requirements.txt",
  "builds": [
    { "src": "api/**/*.py", "use": "@vercel/python" },
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "public/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/tts", "dest": "/api/tts.py" },
    { "src": "/api/tts-with-timing", "dest": "/api/tts-with-timing.py" },
    { "src": "/api/voices", "dest": "/api/voices.js" },
    { "src": "/api/autochat/(.*)", "dest": "/api/autochat/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type,Authorization" }
      ]
    }
  ]
}