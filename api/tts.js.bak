const crypto = require('crypto');
const WebSocket = require('ws');

const TRUSTED_CLIENT_TOKEN = '6A5AA1D4EAFF4E9FB37E23D68491D6F4';
const CHROMIUM_FULL_VERSION = '143.0.3650.75';
const CHROMIUM_MAJOR_VERSION = CHROMIUM_FULL_VERSION.split('.')[0];
const WSS_BASE = 'speech.platform.bing.com/consumer/speech/synthesize/readaloud';
const EXTENSION_ORIGIN = 'chrome-extension://jdiccldimpdaibmpdkjnbmckianbfold';
const WIN_EPOCH = 11644473600;
const S_TO_NS = 1e9;

let _clockSkewSeconds = 0;

function _nowUnix() {
  return Math.floor(Date.now() / 1000) + _clockSkewSeconds;
}

function generateSecMsgGec() {
  let ticks = _nowUnix();
  ticks += WIN_EPOCH;
  ticks -= ticks % 300; // round down to 5 minutes
  ticks = ticks * (S_TO_NS / 100);
  const strToHash = `${Math.floor(ticks)}${TRUSTED_CLIENT_TOKEN}`;
  return crypto.createHash('sha256').update(strToHash, 'ascii').digest('hex').toUpperCase();
}

const BASE_HEADERS = {
  'User-Agent': `Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/${CHROMIUM_MAJOR_VERSION}.0.0.0 Safari/537.36 Edg/${CHROMIUM_MAJOR_VERSION}.0.0.0`,
  'Accept-Encoding': 'gzip, deflate, br, zstd',
  'Accept-Language': 'en-US,en;q=0.9',
};

function uuid() {
  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {
    const r = (Math.random() * 16) | 0;
    const v = c === 'x' ? r : (r & 0x3) | 0x8;
    return v.toString(16);
  }).replace(/-/g, '');
}

function buildSsml(text, voice, rate, pitch) {
  const lang = voice.split('-').slice(0, 2).join('-') || 'en-US';
  const escaped = String(text)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&apos;');
  return `<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xmlns:mstts="https://www.w3.org/2001/mstts" xml:lang="${lang}">
  <voice name="${voice}">
    <prosody rate="${rate}" pitch="${pitch}">
      ${escaped}
    </prosody>
  </voice>
</speak>`;
}

function synthesize(text, voice, rate, pitch) {
  return new Promise((resolve, reject) => {
    const url = `wss://${WSS_BASE}/edge/v1?TrustedClientToken=${TRUSTED_CLIENT_TOKEN}`;
    const requestId = uuid();
    const ssml = buildSsml(text, voice, rate, pitch);
    let ws;
    let timeout = setTimeout(() => {
      try { ws && ws.terminate(); } catch (e) {}
      reject(new Error('TTS timeout (25s) - đoạn quá dài hoặc mạng chậm'));
    }, 25000);
    const audioChunks = [];
    let started = false;
    try {
      const secMsgGec = generateSecMsgGec();
      const wsHeaders = Object.assign({}, BASE_HEADERS, {
        'Pragma': 'no-cache',
        'Cache-Control': 'no-cache',
        'Origin': EXTENSION_ORIGIN,
        'Sec-WebSocket-Version': '13',
        'Sec-MS-GEC': secMsgGec,
        'Sec-MS-GEC-Version': `1-${CHROMIUM_FULL_VERSION}`,
      });
      ws = new WebSocket(url, { headers: wsHeaders, followRedirects: true });
    } catch (err) {
      return reject(err);
    }
    ws.on('error', (err) => { clearTimeout(timeout); reject(new Error('WebSocket lỗi: ' + err.message)); });
    ws.on('upgrade', (resp) => {
      if (resp.statusCode === 401) {
        const dateHdr = resp.headers && resp.headers.date;
        if (dateHdr && typeof dateHdr === 'string') {
          const serverTs = Math.floor(new Date(dateHdr).getTime() / 1000);
          const localTs = Math.floor(Date.now() / 1000);
          _clockSkewSeconds = serverTs - localTs;
        }
      }
    });
    ws.on('open', () => {
      const cfgMsg = `X-RequestId:${requestId}\r\nContent-Type:application/json;charset=utf-8\r\nPath:speech.config\r\n\r\n` +
        JSON.stringify({ context: { synthesis: { audio: { metadataoptions: { sentenceBoundaryEnabled: 'false', wordBoundaryEnabled: 'false' }, OutputFormat: 'audio-24khz-48kbitrate-mono-mp3' } } } });
      ws.send(cfgMsg);
      ws.send(`X-RequestId:${requestId}\r\nContent-Type:application/ssml+xml\r\nPath:ssml\r\n\r\n` + ssml);
      started = true;
    });
    ws.on('message', (data, isBinary) => {
      if (isBinary) {
        const needle = Buffer.from('Path:audio\r\n');
        const idx = data.indexOf(needle);
        if (idx !== -1) {
          const audioStart = idx + needle.length + 2;
          if (audioStart < data.length) audioChunks.push(data.subarray(audioStart));
        } else if (audioChunks.length > 0) {
          audioChunks.push(data);
        }
        return;
      }
      const str = data.toString('utf-8');
      if (str.includes('Path:turn.end')) {
        clearTimeout(timeout);
        try { ws.close(); } catch (e) {}
        resolve(Buffer.concat(audioChunks));
      }
    });
    ws.on('close', () => {
      clearTimeout(timeout);
      if (audioChunks.length > 0) resolve(Buffer.concat(audioChunks));
      else if (started) reject(new Error('Kết nối đóng trước khi nhận được âm thanh'));
    });
  });
}

export default async function handler(req, res) {
  if (req.method === 'OPTIONS') return res.status(200).end();
  if (req.method !== 'POST') return res.status(405).json({ error: 'Method Not Allowed' });
  try {
    const { text, voice, rate = '+0%', pitch = '+0Hz' } = req.body || {};
    if (!text || !String(text).trim()) return res.status(400).json({ error: 'Text is required' });
    if (!voice) return res.status(400).json({ error: 'Voice is required' });
    const cleanText = String(text).trim();
    if (cleanText.length > 2500) return res.status(413).json({ error: 'Text quá dài (>2500 ký tự). Hãy chia thành các đoạn nhỏ hơn.' });
    const audioBuffer = await synthesize(cleanText, voice, rate, pitch);
    if (!audioBuffer || audioBuffer.length < 100) return res.status(500).json({ error: 'Không tạo được âm thanh (buffer quá nhỏ). Thử lại với giọng khác.' });
    res.setHeader('Content-Type', 'audio/mpeg');
    res.setHeader('Content-Length', audioBuffer.length);
    res.setHeader('Cache-Control', 'public, max-age=3600');
    res.status(200).send(audioBuffer);
  } catch (err) {
    console.error('[TTS ERROR]', err.message);
    res.status(500).json({ error: err.message || 'TTS lỗi không xác định' });
  }
}
